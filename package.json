{
  "name": "theme-change",
  "version": "3.0.4",
  "description": "Change CSS theme with toggle, buttons or select using CSS Variables and localStorage",
  "keywords": [
    "javascript",
    "theming",
    "theme",
    "css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./btn": {
      "types": "./btn.d.ts",
      "default": "./btn.mjs"
    },
    "./select": {
      "types": "./select.d.ts",
      "default": "./select.mjs"
    },
    "./toggle": {
      "types": "./toggle.d.ts",
      "default": "./toggle.mjs"
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.mjs",
    "toggle.js",
    "toggle.mjs",
    "select.js",
    "select.mjs",
    "btn.js",
    "btn.mjs",
    "index.d.ts",
    "btn.d.ts",
    "select.d.ts",
    "toggle.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadeghi/theme-change.git"
  },
  "author": "Pouya Saadeghi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/saadeghi/theme-change/issues"
  },
  "homepage": "https://github.com/saadeghi/theme-change#readme",
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {}
}
